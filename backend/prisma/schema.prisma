generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Service {
  id           String         @id
  name         String
  subtitle     String
  description  String
  features     String[]       // represented as _text (text array) in the database
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ServiceImage ServiceImage[]
}

model ServiceImage {
  id        String   @id
  url       String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Theme {
  id          String   @id
  name        String
  category    String
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
